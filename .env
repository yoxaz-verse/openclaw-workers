SERVER_URL=https://emarketing-backend.infra.obaol.com
WORKER_SECRET=replace_with_openclaw_worker_secret
POLL_INTERVAL_MS=30000

# Runtime mode: hybrid (default) | cli | api
WORKER_EXECUTION_MODE=hybrid

# CLI mode/fallback settings
OPENCLAW_COMMAND=openclaw
OPENCLAW_TIMEOUT_MS=180000

# API mode/fallback settings
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=180000

# Container health settings
HEARTBEAT_FILE=/tmp/openclaw-worker-heartbeat
HEALTHCHECK_MAX_HEARTBEAT_AGE_MS=120000
